# Production settings for deploy/docker-compose.prod.yml (copy to deploy/prod.env; docs/ops/deploy.md).
# Secrets do not belong here: they are files in deploy/secrets/ (deploy/make-secrets.sh).

# Public address. Caddy gets a Let's Encrypt certificate for this host name (ports 80 and 443 open).
TCMS_SITE_ADDRESS=assay.example.com
TCMS_BASE_URL=https://assay.example.com
CADDY_GLOBAL_OPTIONS=

TCMS_ENV=production
TCMS_PRODUCT_NAME=Assay
LOG_LEVEL=INFO
API_REPLICAS=2
WORKER_CONCURRENCY=4
# Requests per minute per caller and API process (0 turns it off); sign-in attempts per minute per address.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=20
# PostgreSQL memory for an 8 GB host (defaults in docker-compose.prod.yml); lower them on smaller hosts.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=5GB
PG_WORK_MEM=32MB
PG_MAX_CONNECTIONS=200

# Object storage: the bundled MinIO by default; for an external S3 set the endpoint and key id here and the
# secret in deploy/secrets/s3_secret_access_key.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=tcms-attachments
S3_ACCESS_KEY_ID=tcms

# Outgoing mail (password in deploy/secrets/smtp_password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=assay@example.com
SMTP_FROM=Assay <assay@example.com>
SMTP_STARTTLS=true

# Where deploy/backup.sh writes (mounted into the db container as /backups).
TCMS_BACKUP_DIR=./backups
