# Local drill of the production stack (docs/ops/deploy.md §Local drill). Not for a real host.
TCMS_SITE_ADDRESS=localhost
TCMS_BASE_URL=https://localhost
CADDY_GLOBAL_OPTIONS=local_certs
# `staging` runs the production images and settings but allows the demo seed, so the E2E suite can be the
# smoke test. A short production-mode check (TCMS_ENV=production) follows in the drill.
TCMS_ENV=staging
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=Assay <no-reply@localhost>
TCMS_BACKUP_DIR=./backups
