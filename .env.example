# Local development settings for docker-compose (copy to .env; `make up` does this on first run).
# Values here are for a local machine only. Never reuse them anywhere else.

# Host ports (change if something else on your machine already uses them)
TCMS_WEB_PORT=5173
TCMS_API_PORT=8000
TCMS_DB_PORT=5433
TCMS_MAILPIT_PORT=8025
TCMS_MINIO_PORT=9000
TCMS_MINIO_CONSOLE_PORT=9001

TCMS_ENV=local
TCMS_PRODUCT_NAME=Assay
TCMS_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database (role passwords are set by ops/db/init-roles.sh on first start of the db volume)
POSTGRES_PASSWORD=local-postgres
TCMS_DB_OWNER_PASSWORD=local-owner
TCMS_DB_APP_PASSWORD=local-app
TCMS_DB_READONLY_PASSWORD=local-readonly

# Object storage (MinIO)
MINIO_ROOT_USER=tcms-local
MINIO_ROOT_PASSWORD=tcms-local-secret
S3_BUCKET=tcms-attachments
